@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
	color-scheme: light dark;
	--qsd-ground: #16181d;
	--qsd-panel: #1e2128;
	--qsd-raise: #262a33;
	--qsd-ink: #e8eaf0;
	--qsd-dim: #a7adba;
	--qsd-seam: #2e333d;
	--qsd-accent: #6ea8fe;
	--qsd-accent-ink: #0b1220;
	--qsd-ok: #3fb950;
	--qsd-warn: #d29922;
	--qsd-danger: #f85149;
	--qsd-radius-s: 6px;
	--qsd-radius-m: 10px;
}

@media (prefers-color-scheme: light) {
	:root {
		--qsd-ground: #f4f5f7;
		--qsd-panel: #ffffff;
		--qsd-raise: #eceef3;
		--qsd-ink: #1a1d23;
		--qsd-dim: #5b6270;
		--qsd-seam: #e0e3ea;
		--qsd-accent: #0b5bd3;
		--qsd-accent-ink: #ffffff;
	}
}

html,
body,
#app {
	font-family: system-ui, -apple-system, 'Segoe UI', Ubuntu, Cantarell, sans-serif;
	background: var(--qsd-ground);
	color: var(--qsd-ink);
}

::selection {
	background: var(--qsd-accent);
	color: var(--qsd-accent-ink);
}

:focus-visible {
	outline: 2px solid var(--qsd-accent);
	outline-offset: 2px;
}

* {
	scrollbar-width: thin;
	scrollbar-color: var(--qsd-seam) transparent;
}
*::-webkit-scrollbar {
	width: 8px;
	height: 8px;
}
*::-webkit-scrollbar-thumb {
	background: var(--qsd-seam);
	border-radius: 4px;
}

.qsd-mono {
	font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
	font-variant-numeric: tabular-nums;
	font-feature-settings: 'tnum' 1, 'zero' 1;
}

.qsd-label {
	font-size: 11px;
	font-weight: 600;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--qsd-dim);
}

.qsd-panel {
	background: var(--qsd-panel);
	border: 1px solid var(--qsd-seam);
	border-radius: var(--qsd-radius-m);
}

.qsd-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
	min-height: 36px;
	padding: 8px 16px;
	border-radius: var(--qsd-radius-s);
	font-size: 13px;
	font-weight: 500;
	line-height: 1.4;
	cursor: pointer;
	border: 1px solid transparent;
	transition: background-color 150ms ease-out, border-color 150ms ease-out, opacity 150ms ease-out;
	user-select: none;
}
.qsd-btn:disabled {
	opacity: 0.4;
	cursor: not-allowed;
}
.qsd-btn-primary {
	background: var(--qsd-accent);
	color: var(--qsd-accent-ink);
}
.qsd-btn-primary:hover:not(:disabled) {
	filter: brightness(0.92);
}
.qsd-btn-ghost {
	background: var(--qsd-raise);
	color: var(--qsd-ink);
	border-color: var(--qsd-seam);
}
.qsd-btn-ghost:hover:not(:disabled) {
	filter: brightness(1.08);
}
.qsd-btn-danger-ghost {
	background: transparent;
	color: var(--qsd-danger);
	border-color: var(--qsd-seam);
}
.qsd-btn-danger-ghost:hover:not(:disabled),
.qsd-btn-danger-ghost:focus-visible {
	border-color: var(--qsd-danger);
}

.qsd-input {
	background: var(--qsd-raise);
	border: 1px solid var(--qsd-seam);
	border-radius: var(--qsd-radius-s);
	color: var(--qsd-ink);
	font-size: 13px;
	padding: 8px 12px;
	width: 100%;
}
.qsd-input::placeholder {
	color: var(--qsd-dim);
	opacity: 1;
}

.qsd-seg {
	display: inline-flex;
	background: var(--qsd-raise);
	border: 1px solid var(--qsd-seam);
	border-radius: var(--qsd-radius-s);
	padding: 2px;
	gap: 2px;
}
.qsd-seg button {
	border-radius: 4px;
	padding: 4px 10px;
	font-size: 12px;
	font-weight: 500;
	color: var(--qsd-dim);
	white-space: nowrap;
}
.qsd-seg button[aria-checked='true'] {
	background: var(--qsd-accent);
	color: var(--qsd-accent-ink);
}

.qsd-row-btn {
	width: 100%;
	text-align: left;
	border: 1px solid var(--qsd-seam);
	background: var(--qsd-panel);
	border-radius: var(--qsd-radius-m);
	padding: 12px;
	transition: background-color 150ms ease-out, border-color 150ms ease-out;
}
.qsd-row-btn:hover:not(:disabled) {
	background: var(--qsd-raise);
}
.qsd-row-btn[data-selected='true'] {
	border-color: var(--qsd-accent);
}
.qsd-row-btn:disabled {
	opacity: 0.5;
}

.qsd-drop-active {
	background: var(--qsd-raise);
	border-color: var(--qsd-accent);
}

@layer utilities {
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
}

/* Blueprint schematic layer (pinned user direction, overrides quiet-console restraint) */
.bp-dots {
	background-image: radial-gradient(#1e293b 1px, transparent 1px);
	background-size: 16px 16px;
}

@keyframes flow {
	to { stroke-dashoffset: -20; }
}
.flow-line {
	stroke-dasharray: 6 6;
	animation: flow 1s linear infinite;
}

@keyframes pulse-dot {
	0%, 100% { opacity: 1; }
	50% { opacity: 0.25; }
}
.pulse-dot {
	animation: pulse-dot 1.6s ease-in-out infinite;
}

.radar-sweep {
	transform-origin: 100px 100px;
	animation: radar-spin 3s linear infinite;
}
@keyframes radar-spin {
	to { transform: rotate(360deg); }
}
@keyframes radar-ping {
	0%, 100% { opacity: 0.9; }
	50% { opacity: 0.15; }
}
.radar-ping {
	animation: radar-ping 2.2s ease-in-out infinite;
}

.bp-sketch {
	border: 2px solid #fb923c;
	border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
}

@media (prefers-reduced-motion: reduce) {
	.flow-line,
	.pulse-dot,
	.radar-sweep,
	.radar-ping {
		animation: none;
	}
}
