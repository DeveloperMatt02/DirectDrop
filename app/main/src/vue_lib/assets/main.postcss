@tailwind base;
@tailwind components;
@tailwind utilities;

/*
 * Theme tokens. Light ("Carta chiara") is the default; dark ("Console calma")
 * applies when the system prefers it, unless the Tauri window theme pins one
 * via html[data-theme] (see composables/systemTheme.ts). Components use these
 * only through the Tailwind colors in tailwind.config.cjs.
 * Contrast tweaks vs the proposals: dark --qsd-faint #5f7287 -> #72869c and
 * dark --qsd-primary #2b7fff -> #1f6fe6, both to reach 4.5:1.
 */
:root {
	color-scheme: light;
	--qsd-radius-s: 6px;
	--qsd-radius-m: 10px;
	--qsd-ground: #f4f2ee;
	--qsd-panel: #ffffff;
	--qsd-raise: #ece8e0;
	--qsd-seam: #e6e2da;
	--qsd-ink: #1d2330;
	--qsd-dim: #5b6472;
	--qsd-faint: #5b6472;
	--qsd-accent: #2f4fc2;
	--qsd-accent-ink: #ffffff;
	--qsd-accent-text: #2f4fc2;
	--qsd-accent-soft: #e3e9fb;
	--qsd-primary: #1d2330;
	--qsd-primary-ink: #ffffff;
	--qsd-rx: #0f7a52;
	--qsd-rx-bg: #dff3ea;
	--qsd-tx: #2f4fc2;
	--qsd-tx-bg: #e3e9fb;
	--qsd-cancel: #a3261a;
	--qsd-cancel-bg: #fde4e1;
	--qsd-cancel-border: #f3c4be;
	--qsd-warn: #8a5a00;
	--qsd-warn-bg: #fbf0d9;
	--qsd-ok: #0f7a52;
	--qsd-danger: #a3261a;
	--qsd-overlay: rgb(29 35 48 / 0.35);
}

@media (prefers-color-scheme: dark) {
	:root:not([data-theme='light']) {
		color-scheme: dark;
		--qsd-ground: #0b1118;
		--qsd-panel: #101923;
		--qsd-raise: #121b25;
		--qsd-seam: #1c2733;
		--qsd-ink: #dbe4ee;
		--qsd-dim: #7c8ea3;
		--qsd-faint: #72869c;
		--qsd-accent: #2b7fff;
		--qsd-accent-ink: #0b1118;
		--qsd-accent-text: #8fb7ff;
		--qsd-accent-soft: #152b4b;
		--qsd-primary: #1f6fe6;
		--qsd-primary-ink: #ffffff;
		--qsd-rx: #4fd1a5;
		--qsd-rx-bg: #10382f;
		--qsd-tx: #6aa8ff;
		--qsd-tx-bg: #14304f;
		--qsd-cancel: #ff9aa8;
		--qsd-cancel-bg: #2a141a;
		--qsd-cancel-border: #5a2b36;
		--qsd-warn: #f0b45a;
		--qsd-warn-bg: #2a2213;
		--qsd-ok: #4fd1a5;
		--qsd-danger: #ff9aa8;
	--qsd-overlay: rgb(0 0 0 / 0.6);
	}
}

:root[data-theme='dark'] {
	color-scheme: dark;
	--qsd-ground: #0b1118;
	--qsd-panel: #101923;
	--qsd-raise: #121b25;
	--qsd-seam: #1c2733;
	--qsd-ink: #dbe4ee;
	--qsd-dim: #7c8ea3;
	--qsd-faint: #72869c;
	--qsd-accent: #2b7fff;
	--qsd-accent-ink: #0b1118;
	--qsd-accent-text: #8fb7ff;
	--qsd-accent-soft: #152b4b;
	--qsd-primary: #1f6fe6;
	--qsd-primary-ink: #ffffff;
	--qsd-rx: #4fd1a5;
	--qsd-rx-bg: #10382f;
	--qsd-tx: #6aa8ff;
	--qsd-tx-bg: #14304f;
	--qsd-cancel: #ff9aa8;
	--qsd-cancel-bg: #2a141a;
	--qsd-cancel-border: #5a2b36;
	--qsd-warn: #f0b45a;
	--qsd-warn-bg: #2a2213;
	--qsd-ok: #4fd1a5;
	--qsd-danger: #ff9aa8;
	--qsd-overlay: rgb(0 0 0 / 0.6);
}

html,
body,
#app {
	font-family: system-ui, -apple-system, 'Segoe UI', Ubuntu, Cantarell, sans-serif;
	background: var(--qsd-ground);
	color: var(--qsd-ink);
}

::selection {
	background: var(--qsd-accent);
	color: var(--qsd-accent-ink);
}

:focus-visible {
	outline: 2px solid var(--qsd-accent);
	outline-offset: 2px;
}

* {
	scrollbar-width: thin;
	scrollbar-color: var(--qsd-seam) transparent;
}
*::-webkit-scrollbar {
	width: 8px;
	height: 8px;
}
*::-webkit-scrollbar-thumb {
	background: var(--qsd-seam);
	border-radius: 4px;
}

.qsd-mono {
	font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
	font-variant-numeric: tabular-nums;
	font-feature-settings: 'tnum' 1, 'zero' 1;
}

.qsd-label {
	font-size: 11px;
	font-weight: 600;
	letter-spacing: 0.06em;
	text-transform: uppercase;
	color: var(--qsd-dim);
}

.qsd-panel {
	background: var(--qsd-panel);
	border: 1px solid var(--qsd-seam);
	border-radius: var(--qsd-radius-m);
}

.qsd-btn {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 8px;
	min-height: 36px;
	padding: 8px 16px;
	border-radius: var(--qsd-radius-s);
	font-size: 13px;
	font-weight: 500;
	line-height: 1.4;
	cursor: pointer;
	border: 1px solid transparent;
	transition: background-color 150ms ease-out, border-color 150ms ease-out, opacity 150ms ease-out;
	user-select: none;
}
.qsd-btn:disabled {
	opacity: 0.4;
	cursor: not-allowed;
}
.qsd-btn-primary {
	background: var(--qsd-accent);
	color: var(--qsd-accent-ink);
}
.qsd-btn-primary:hover:not(:disabled) {
	filter: brightness(0.92);
}
.qsd-btn-ghost {
	background: var(--qsd-raise);
	color: var(--qsd-ink);
	border-color: var(--qsd-seam);
}
.qsd-btn-ghost:hover:not(:disabled) {
	filter: brightness(1.08);
}
.qsd-btn-danger-ghost {
	background: transparent;
	color: var(--qsd-danger);
	border-color: var(--qsd-seam);
}
.qsd-btn-danger-ghost:hover:not(:disabled),
.qsd-btn-danger-ghost:focus-visible {
	border-color: var(--qsd-danger);
}

.qsd-input {
	background: var(--qsd-raise);
	border: 1px solid var(--qsd-seam);
	border-radius: var(--qsd-radius-s);
	color: var(--qsd-ink);
	font-size: 13px;
	padding: 8px 12px;
	width: 100%;
}
.qsd-input::placeholder {
	color: var(--qsd-dim);
	opacity: 1;
}

.qsd-seg {
	display: inline-flex;
	background: var(--qsd-raise);
	border: 1px solid var(--qsd-seam);
	border-radius: var(--qsd-radius-s);
	padding: 2px;
	gap: 2px;
}
.qsd-seg button {
	border-radius: 4px;
	padding: 4px 10px;
	font-size: 12px;
	font-weight: 500;
	color: var(--qsd-dim);
	white-space: nowrap;
}
.qsd-seg button[aria-checked='true'] {
	background: var(--qsd-accent);
	color: var(--qsd-accent-ink);
}

.qsd-row-btn {
	width: 100%;
	text-align: left;
	border: 1px solid var(--qsd-seam);
	background: var(--qsd-panel);
	border-radius: var(--qsd-radius-m);
	padding: 12px;
	transition: background-color 150ms ease-out, border-color 150ms ease-out;
}
.qsd-row-btn:hover:not(:disabled) {
	background: var(--qsd-raise);
}
.qsd-row-btn[data-selected='true'] {
	border-color: var(--qsd-accent);
}
.qsd-row-btn:disabled {
	opacity: 0.5;
}

.qsd-drop-active {
	background: var(--qsd-raise);
	border-color: var(--qsd-accent);
}

/* Row and panel actions: real buttons, 40px hit area. */
.qsd-action {
	display: inline-flex;
	align-items: center;
	justify-content: center;
	gap: 6px;
	min-height: 40px;
	min-width: 40px;
	padding: 0 14px;
	border: 1px solid var(--qsd-seam);
	border-radius: var(--qsd-radius-s);
	background: var(--qsd-panel);
	color: var(--qsd-ink);
	font-family: ui-monospace, 'Cascadia Mono', 'JetBrains Mono', Menlo, Consolas, monospace;
	font-size: 12px;
	font-weight: 600;
	letter-spacing: 0.04em;
	white-space: nowrap;
	transition: background-color 150ms ease-out, border-color 150ms ease-out;
}
.qsd-action:hover:not(:disabled) {
	background: var(--qsd-raise);
	border-color: var(--qsd-dim);
}
.qsd-action:disabled {
	opacity: 0.45;
	cursor: not-allowed;
}
.qsd-action-primary {
	background: var(--qsd-primary);
	border-color: var(--qsd-primary);
	color: var(--qsd-primary-ink);
}
.qsd-action-primary:hover:not(:disabled) {
	background: var(--qsd-primary);
	border-color: var(--qsd-primary);
	filter: brightness(1.12);
}
.qsd-action-cancel {
	background: transparent;
	border-color: var(--qsd-cancel-border);
	color: var(--qsd-cancel);
}
.qsd-action-cancel:hover:not(:disabled) {
	background: var(--qsd-cancel-bg);
	border-color: var(--qsd-cancel);
}

/* Sidebar radar: slow outward waves while the device is discoverable. */
@keyframes radar-wave {
	from {
		transform: scale(0.3);
		opacity: 0.6;
	}
	to {
		transform: scale(1);
		opacity: 0;
	}
}
.radar-wave {
	transform-origin: center;
	transform-box: fill-box;
	animation: radar-wave 4.8s ease-out infinite;
}
.radar-wave-late {
	animation-delay: 2.4s;
}

@layer utilities {
	.no-scrollbar::-webkit-scrollbar {
		display: none;
	}
	.no-scrollbar {
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
}

/* Blueprint schematic layer (pinned user direction, overrides quiet-console restraint) */
.bp-dots {
	background-image: radial-gradient(var(--qsd-seam) 1px, transparent 1px);
	background-size: 16px 16px;
}

@keyframes flow {
	to { stroke-dashoffset: -20; }
}
.flow-line {
	stroke-dasharray: 6 6;
	animation: flow 1s linear infinite;
}

@keyframes pulse-dot {
	0%, 100% { opacity: 1; }
	50% { opacity: 0.25; }
}
.pulse-dot {
	animation: pulse-dot 1.6s ease-in-out infinite;
}

.radar-sweep {
	transform-origin: 100px 100px;
	animation: radar-spin 3s linear infinite;
}
@keyframes radar-spin {
	to { transform: rotate(360deg); }
}
@keyframes radar-ping {
	0%, 100% { opacity: 0.9; }
	50% { opacity: 0.15; }
}
.radar-ping {
	animation: radar-ping 2.2s ease-in-out infinite;
}

.bp-sketch {
	border: 2px solid var(--qsd-accent);
	border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
}

@media (prefers-reduced-motion: reduce) {
	.flow-line,
	.pulse-dot,
	.radar-sweep,
	.radar-ping {
		animation: none;
	}
	.radar-wave {
		animation: none;
		opacity: 0;
	}
}
